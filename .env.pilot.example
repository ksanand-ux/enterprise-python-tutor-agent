# Copy privately to .env.pilot; never commit populated values.
TUTOR_MODE=pilot
TUTOR_NAMESPACE=staging
# Map opaque caller IDs to SHA-256 hashes from scripts.pilot_admin issue.
TUTOR_CALLERS_JSON={}
REDIS_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
TUTOR_REQUESTS_PER_MINUTE=5
TUTOR_REQUESTS_PER_DAY=20
TUTOR_GLOBAL_REQUESTS_PER_DAY=50
TUTOR_MAX_CONCURRENT=2
TUTOR_MODEL_TIMEOUT_SECONDS=45
TUTOR_MAX_OUTPUT_TOKENS=1200
TUTOR_MODEL_ENABLED=true
# Optional token-price estimates; fill all four from current provider pricing.
# Estimates exclude search/tool fees and are not a spending cap.
TUTOR_PRICE_BASIS=
TUTOR_INPUT_USD_PER_MILLION=
TUTOR_CACHED_INPUT_USD_PER_MILLION=
TUTOR_OUTPUT_USD_PER_MILLION=
